
&НаСервере
&После("ПриСозданииНаСервере")
Процедура ДополнитьУпаковкиПослеСоздания(Отказ, СтандартнаяОбработка)

    ЗаполнитьУпаковкиПоРаспоряжению();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУпаковкиПоРаспоряжению()

    ДокументОбъект = ЭтаФорма.Объект;
    
      Если НЕ ДокументОбъект.Ссылка.Пустая() Тогда
        Возврат;
    КонецЕсли;
    
    Основание = ДокументОбъект.Распоряжение;
    
       Если Основание = Неопределено 
       ИЛИ ТипЗнч(Основание) <> Тип("ДокументСсылка.ДвижениеПродукцииИМатериалов") Тогда
 
        Возврат;
    КонецЕсли;
    
        Распоряжение = Основание.ПолучитьОбъект();
    
    ЗаполнитьТоварыУпаковками(ДокументОбъект, Распоряжение);
	

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыУпаковками(ДокументОбъект, Распоряжение)

    Товары = ДокументОбъект.Товары;
    Товары.Очистить();
	
	СтруктураДействий = Новый Структура;
    СтруктураДействий.Вставить("ЗаполнитьВесУпаковки", Новый Структура("Номенклатура, Упаковка", "ВесУпаковки"));
    СтруктураДействий.Вставить("ЗаполнитьОбъемУпаковки", Новый Структура("Номенклатура, Упаковка", "ОбъемУпаковки"));
    СтруктураДействий.Вставить("ЗаполнитьЕдиницуИзмеренияВеса", Новый Структура("Номенклатура, Упаковка", "ЕдиницаИзмеренияВеса"));
    СтруктураДействий.Вставить("ЗаполнитьЕдиницуИзмеренияОбъема", Новый Структура("Номенклатура, Упаковка", "ЕдиницаИзмеренияОбъема"));
    СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
    СтруктураДействий.Вставить("ПересчитатьВесОбъем");
	
	
       Для Каждого СтрокаРаспоряжения Из Распоряжение.Товары Цикл
        
            МассивУпаковок = ПолучитьУпаковкиИзСтроки(СтрокаРаспоряжения);
        
        Если МассивУпаковок.Количество() = 0 Тогда
            
            НоваяСтрока = Товары.Добавить();
            НоваяСтрока.Номенклатура = СтрокаРаспоряжения.Номенклатура;
            НоваяСтрока.Количество = СтрокаРаспоряжения.Количество;  
			НоваяСтрока.СтатусУказанияСерий = 5;
            НоваяСтрока.Упаковка = Неопределено;
            НоваяСтрока.КоличествоУпаковок = 0; // или Неопределено    
			ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий);
            Продолжить;
        КонецЕсли;
        
        Для Каждого ДанныеУпаковки Из МассивУпаковок Цикл
            НоваяСтрока = Товары.Добавить();
            НоваяСтрока.Номенклатура = СтрокаРаспоряжения.Номенклатура;
            НоваяСтрока.Упаковка = ДанныеУпаковки.Упаковка;
            НоваяСтрока.КоличествоУпаковок = ДанныеУпаковки.Количество;
            НоваяСтрока.Количество = СтрокаРаспоряжения.Количество; 
			НоваяСтрока.СтатусУказанияСерий = 5;
            ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий);

        КонецЦикла;
        
	КонецЦикла;	

КонецПроцедуры

&НаСервере
Процедура ОбработатьСтрокуТЧ(СтрокаТЧ, СтруктураДействий)
	
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТЧ, СтруктураДействий, Неопределено);
         
        
КонецПроцедуры

&НаСервере
Функция ПолучитьУпаковкиИзСтроки(СтрокаРаспоряжения)

    Результат = Новый Массив;
    
        Если ЗначениеЗаполнено(СтрокаРаспоряжения.Упаковка) 
           И СтрокаРаспоряжения.КоличествоУпаковок > 0 Тогда
            СтруктураУпаковки = Новый Структура("Упаковка, Количество");
            СтруктураУпаковки.Упаковка = СтрокаРаспоряжения.Упаковка;
            СтруктураУпаковки.Количество = СтрокаРаспоряжения.КоличествоУпаковок;
            Результат.Добавить(СтруктураУпаковки);
        КонецЕсли;
       
    Возврат Результат;
    
КонецФункции

&НаСервереБезКонтекста
Функция НайтиНоменклатуруПоставщика(Номенклатура, Контрагент)
    Если Номенклатура = Неопределено Или Контрагент = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   НоменклатураПоставщика.Ссылка КАК Ссылка
        |ИЗ
        |   Справочник.НоменклатураКонтрагентов КАК НоменклатураПоставщика
        |ГДЕ
        |   НоменклатураПоставщика.Номенклатура = &Номенклатура
        |   И НоменклатураПоставщика.ВладелецНоменклатуры = &Контрагент";
    
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("Контрагент", Контрагент);
    
    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Ссылка;
КонецФункции


&НаСервереБезКонтекста
Функция ОснованиеЭтоЗаказИлиПриобретение(Распоряжение)
    Если Распоряжение = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    
    ТипРаспоряжения = ТипЗнч(Распоряжение);
    Возврат (ТипРаспоряжения = Тип("ДокументСсылка.ЗаказПоставщику")
             Или ТипРаспоряжения = Тип("ДокументСсылка.ПриобретениеТоваровУслуг"));
КонецФункции

