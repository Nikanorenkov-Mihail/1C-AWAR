&НаСервере
Процедура СБ_ПриОткрытииПослеНаСервере() 
	
	СБ_РаботаСДрагоценнымиМеталлами.ЗаполнитьПустуюТаблицуДрагМеталлы(Объект.ОтгружаемыеТовары, Объект.СБ_ДрагоценныеМеталлы, Объект.Склад); 
	
	//Дерево = РеквизитФормыВЗначение("ДеревоДрагМеталлы");
	ДеревоИзТаблицы = СБ_РаботаСДрагоценнымиМеталлами.ВыгрузитьТаблицуЗначенийВДеревоЗначений(Объект.СБ_ДрагоценныеМеталлы.Выгрузить(), "Родитель", "Родитель");
	ЗначениеВРеквизитФормы(ДеревоИзТаблицы, "ДеревоДрагМеталлы");

	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		Элементы.ГруппаДрагоценныеМеталлы.Видимость = СБ_РаботаСДрагоценнымиМеталлами.СкладИспользуетОрдернуюСхему(Объект.Склад);
	Иначе
		Элементы.ГруппаДрагоценныеМеталлы.Видимость = Ложь;
		Объект.СБ_ДрагоценныеМеталлы.Очистить();
	КонецЕсли;
	
КонецПроцедуры

