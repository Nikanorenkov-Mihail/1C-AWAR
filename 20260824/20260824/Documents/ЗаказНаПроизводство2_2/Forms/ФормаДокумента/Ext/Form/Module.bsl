&НаСервере
Процедура ЗаполнитьПоПланамПроизводства()
	
	ДанныеЗаполнения = ПолучитьДанныеПланирования();
	
	Для Каждого Строка из ДанныеЗаполнения Цикл
		
		НоваяСтрока = Объект.Продукция.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла
	
КонецПроцедуры

Функция ПолучитьДанныеПланирования()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПланыПотребленияМатериаловОбороты.Номенклатура КАК Номенклатура,
		|	ПланыПотребленияМатериаловОбороты.Характеристика КАК Характеристика,
		|	ВЫБОР
		|		КОГДА ЭтапыПроизводства.Подразделение.ПодразделениеДиспетчер
		|			ТОГДА ЭтапыПроизводства.Подразделение
		|		ИНАЧЕ ЭтапыПроизводства.Подразделение.Родитель
		|	КОНЕЦ КАК Подразделение,
		|	ПланыПотребленияМатериаловОбороты.КоличествоОборот КАК КоличествоОборот,
		|	ВЫБОР &Периодичность
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
		|			ТОГДА ДОБАВИТЬКДАТЕ(ПланыПотребленияМатериаловОбороты.ДатаПроизводства, НЕДЕЛЯ, -&СмещениеПериода)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
		|			ТОГДА ДОБАВИТЬКДАТЕ(ПланыПотребленияМатериаловОбороты.ДатаПроизводства, ДЕКАДА, -&СмещениеПериода)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|			ТОГДА ДОБАВИТЬКДАТЕ(ПланыПотребленияМатериаловОбороты.ДатаПроизводства, МЕСЯЦ, -&СмещениеПериода)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
		|			ТОГДА ДОБАВИТЬКДАТЕ(ПланыПотребленияМатериаловОбороты.ДатаПроизводства, КВАРТАЛ, -&СмещениеПериода)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
		|			ТОГДА ДОБАВИТЬКДАТЕ(ПланыПотребленияМатериаловОбороты.ДатаПроизводства, ПОЛУГОДИЕ, -&СмещениеПериода)
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|			ТОГДА ДОБАВИТЬКДАТЕ(ПланыПотребленияМатериаловОбороты.ДатаПроизводства, ГОД, -&СмещениеПериода)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(ПланыПотребленияМатериаловОбороты.ДатаПроизводства, ДЕНЬ, -&СмещениеПериода)
		|	КОНЕЦ КАК Период,
		|	ПланыПотребленияМатериаловОбороты.ПланПроизводства КАК ПланПроизводства,
		|	СпецификацииИзделий.Спецификация КАК Спецификация,
		|	ЭтапыПроизводства.Ссылка КАК Ссылка,
		|	ПланыПотребленияМатериаловОбороты.ПодразделениеДиспетчер КАК ПодразделениеДиспетчер,
		|	ПланыПотребленияМатериаловОбороты.Склад КАК Склад
		|ПОМЕСТИТЬ Задел
		|ИЗ
		|	РегистрНакопления.ПланыПотребленияМатериалов.Обороты(
		|			,
		|			,
		|			Авто,
		|			Номенклатура.ВидНоменклатуры В ИЕРАРХИИ (&ВидНоменклатуры)
		|				И Сценарий = &СценарийПлана) КАК ПланыПотребленияМатериаловОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СпецификацииИзделий КАК СпецификацииИзделий
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
		|			ПО СпецификацииИзделий.Спецификация = ЭтапыПроизводства.Владелец
		|				И (ЭтапыПроизводства.НомерСледующегоЭтапа = 0)
		|				И (ЭтапыПроизводства.ПометкаУдаления = ЛОЖЬ)
		|		ПО ПланыПотребленияМатериаловОбороты.Номенклатура = СпецификацииИзделий.Номенклатура
		|			И (НЕ СпецификацииИзделий.ПобочныйВыход)
		|			И (СпецификацииИзделий.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСпецификаций.Действует))
		|			И ПланыПотребленияМатериаловОбороты.Характеристика = СпецификацииИзделий.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Период КАК Период,
		|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
		|	ВложенныйЗапрос.Характеристика КАК Характеристика,
		|	ВложенныйЗапрос.Количество КАК Количество,
		|	ВложенныйЗапрос.Подразделение КАК Подразделение,
		|	ВложенныйЗапрос.Сценарий КАК Сценарий,
		|	ВложенныйЗапрос.Статус КАК Статус,
		|	ВложенныйЗапрос.Спецификация КАК Спецификация,
		|	ВложенныйЗапрос.Склад КАК Склад
		|ПОМЕСТИТЬ ВР_Спецификации
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР &Периодичность
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, НЕДЕЛЯ), НЕДЕЛЯ, -&СмещениеПериода)
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, ДЕКАДА), ДЕКАДА, -&СмещениеПериода)
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, МЕСЯЦ), МЕСЯЦ, -&СмещениеПериода)
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, КВАРТАЛ), КВАРТАЛ, -&СмещениеПериода)
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, ПОЛУГОДИЕ), ПОЛУГОДИЕ, -&СмещениеПериода)
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, ГОД), ГОД, -&СмещениеПериода)
		|			ИНАЧЕ ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, ДЕНЬ), ДЕНЬ, -&СмещениеПериода)
		|		КОНЕЦ КАК Период,
		|		Задел.Номенклатура КАК Номенклатура,
		|		Задел.Характеристика КАК Характеристика,
		|		Задел.КоличествоОборот КАК Количество,
		|		ВЫБОР
		|			КОГДА ЭтапыПроизводства.Подразделение.ПодразделениеДиспетчер
		|				ТОГДА ЭтапыПроизводства.Подразделение
		|			ИНАЧЕ ЭтапыПроизводства.Подразделение.Родитель
		|		КОНЕЦ КАК Подразделение,
		|		&СценарийПлана КАК Сценарий,
		|		&Статус КАК Статус,
		|		СпецификацииИзделий.Спецификация КАК Спецификация,
		|		Задел.Склад КАК Склад
		|	ИЗ
		|		Задел КАК Задел
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СпецификацииИзделий КАК СпецификацииИзделий
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
		|				ПО СпецификацииИзделий.Спецификация = ЭтапыПроизводства.Владелец
		|					И (ЭтапыПроизводства.НомерСледующегоЭтапа = 0)
		|			ПО Задел.Номенклатура = СпецификацииИзделий.Номенклатура
		|				И Задел.Характеристика = СпецификацииИзделий.Характеристика
		|				И (НЕ СпецификацииИзделий.ПобочныйВыход)
		|				И (СпецификацииИзделий.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСпецификаций.Действует))
		|	ГДЕ
		|		Задел.Номенклатура.ИспользованиеХарактеристик <> ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)) КАК ВложенныйЗапрос
		|ГДЕ
		|	ВложенныйЗапрос.Подразделение <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Период,
		|	ВложенныйЗапрос.Номенклатура,
		|	ВложенныйЗапрос.Характеристика,
		|	ВложенныйЗапрос.Количество,
		|	ВложенныйЗапрос.Подразделение,
		|	ВложенныйЗапрос.Сценарий,
		|	ВложенныйЗапрос.Статус,
		|	ВложенныйЗапрос.Спецификация,
		|	ВложенныйЗапрос.Склад
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР &Периодичность
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, НЕДЕЛЯ), НЕДЕЛЯ, -&СмещениеПериода)
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, ДЕКАДА), ДЕКАДА, -&СмещениеПериода)
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, МЕСЯЦ), МЕСЯЦ, -&СмещениеПериода)
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, КВАРТАЛ), КВАРТАЛ, -&СмещениеПериода)
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, ПОЛУГОДИЕ), ПОЛУГОДИЕ, -&СмещениеПериода)
		|			КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, ГОД), ГОД, -&СмещениеПериода)
		|			ИНАЧЕ ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Задел.Период, ДЕНЬ), ДЕНЬ, -&СмещениеПериода)
		|		КОНЕЦ КАК Период,
		|		Задел.Номенклатура КАК Номенклатура,
		|		Задел.Характеристика КАК Характеристика,
		|		Задел.КоличествоОборот КАК Количество,
		|		ВЫБОР
		|			КОГДА ЭтапыПроизводства.Подразделение.ПодразделениеДиспетчер
		|				ТОГДА ЭтапыПроизводства.Подразделение
		|			ИНАЧЕ ЭтапыПроизводства.Подразделение.Родитель
		|		КОНЕЦ КАК Подразделение,
		|		&СценарийПлана КАК Сценарий,
		|		&Статус КАК Статус,
		|		СпецификацииИзделий.Спецификация КАК Спецификация,
		|		Задел.Склад КАК Склад
		|	ИЗ
		|		Задел КАК Задел
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СпецификацииИзделий КАК СпецификацииИзделий
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
		|				ПО СпецификацииИзделий.Спецификация = ЭтапыПроизводства.Владелец
		|					И (ЭтапыПроизводства.НомерСледующегоЭтапа = 0)
		|			ПО Задел.Номенклатура = СпецификацииИзделий.Номенклатура
		|				И (Задел.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		|				И (СпецификацииИзделий.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСпецификаций.Действует))
		|				И (НЕ СпецификацииИзделий.ПобочныйВыход)
		|	ГДЕ
		|		Задел.Номенклатура.ИспользованиеХарактеристик <> ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)) КАК ВложенныйЗапрос
		|ГДЕ
		|	ВложенныйЗапрос.Подразделение <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Период,
		|	ВложенныйЗапрос.Номенклатура,
		|	ВложенныйЗапрос.Характеристика,
		|	ВложенныйЗапрос.Количество,
