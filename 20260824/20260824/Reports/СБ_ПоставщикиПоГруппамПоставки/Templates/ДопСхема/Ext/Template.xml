		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    СБ_ПоставщикиПоТоварнымКатегориям.Поставщик КАК Контрагент,
    СБ_ПоставщикиПоТоварнымКатегориям.ТоварнаяКатегория КАК ТоварнаяКатегория,
    СБ_ПоставщикиПоТоварнымКатегориям.Основной КАК Основной,
    СБ_ПоставщикиПоТоварнымКатегориям.Договор КАК Договор,
    СБ_ПоставщикиПоТоварнымКатегориям.Поставщик.СБ_СтепеньЗначимостиПоставщика КАК СтепеньЗначимости,
    СБ_ПоставщикиПоТоварнымКатегориям.Поставщик.ОсновнойМенеджер КАК ОсновнойМенеджер,
    ПартнерыКонтактнаяИнформация.АдресЭП КАК АдресЭП,
    ПартнерыКонтактнаяИнформация.НомерТелефона КАК НомерТелефона,
    NULL КАК ПериодГод,
    NULL КАК ПериодКвартал,
    NULL КАК ПланНаГод,
    NULL КАК ФактЗаКвартал,
    NULL КАК ОценкаПоставщика,
    NULL КАК Квартал,
    NULL КАК Год
ИЗ
    РегистрСведений.СБ_ПоставщикиПоТоварнымКатегориям КАК СБ_ПоставщикиПоТоварнымКатегориям
        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
        ПО СБ_ПоставщикиПоТоварнымКатегориям.Поставщик = ПартнерыКонтактнаяИнформация.Ссылка

ОБЪЕДИНИТЬ

ВЫБРАТЬ
    СБ_ИсторияИзмененийПлан.Контрагент,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    СБ_ИсторияИзмененийПлан.Период,
    СБ_ИсторияИзмененийФакт.Период,
    СБ_ИсторияИзмененийПлан.ПланНаГод,
    СБ_ИсторияИзмененийФакт.ФактЗаКвартал,
    СБ_ИсторияИзмененийФакт.ОценкаПоставщика,
    КВАРТАЛ(СБ_ИсторияИзмененийФакт.Период),
    ГОД(СБ_ИсторияИзмененийПлан.Период)
ИЗ
    РегистрСведений.СБ_ИсторияИзмененийПлан КАК СБ_ИсторияИзмененийПлан
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СБ_ИсторияИзмененийФакт КАК СБ_ИсторияИзмененийФакт
        ПО СБ_ИсторияИзмененийПлан.Контрагент = СБ_ИсторияИзмененийФакт.Контрагент
           И (СБ_ИсторияИзмененийПлан.Период = НАЧАЛОПЕРИОДА(СБ_ИсторияИзмененийФакт.Период, ГОД))
ГДЕ
    СБ_ИсторияИзмененийПлан.Период МЕЖДУ &amp;ДатаНачало И &amp;ДатаКонец
</query>
