&НаСервереБезКонтекста
Процедура ПересчитатьВесаДерева(Дерево) Экспорт
	ПересчитатьСуммыСтрок(Дерево.Строки);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПересчитатьСуммыСтрок(Строки)        
	
	Для каждого Строка Из Строки Цикл
		
		Если Строка.Строки.Количество() > 0 Тогда
			//ПересчитатьУзел(Строка.Строки);   
			
			СуммаЧистый = 0;
			СуммаЛигатурный = 0;
			Для каждого Дочерняя Из Строка.Строки Цикл
				СуммаЧистый = СуммаЧистый + Дочерняя.ЧистыйВес;
				//СуммаЛигатурный = СуммаЛигатурный + Дочерняя.ЛигатурныйВес;
			КонецЦикла;
			
			Строка.ЧистыйВес = СуммаЧистый;
			//Строка.ЛигатурныйВес = СуммаЛигатурный;
		КонецЕсли;  
		
	КонецЦикла;       
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьКоличество(Номенклатура, Характеристика, Серия, КоличествоУпаковок, Склад, ЕдиницаИзмерения) Экспорт  
	
	СтруктураТовар =Новый Структура();
	СтруктураТовар.Вставить("Номенклатура", Номенклатура);
	СтруктураТовар.Вставить("Характеристика", Характеристика);
	СтруктураТовар.Вставить("Серия", Серия);
	СтруктураТовар.Вставить("КоличествоУпаковок", КоличествоУпаковок);
	СтруктураТовар.Вставить("Склад", Склад);
	СтруктураТовар.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
	Дерево = ПересчитатьСтрокуДеревеПриИзмененииСтрокиТовара(СтруктураТовар, РеквизитФормыВЗначение("ДеревоДрагМеталлы"));
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоДрагМеталлы"); 
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПересчитатьСтрокуДеревеПриИзмененииСтрокиТовара(СтруктураТовар, Дерево)        
	
	СтрокаНайдена = Ложь;
	Для каждого Строка Из Дерево.Строки Цикл
		
		Если СтруктураТовар.Номенклатура = Строка.Номенклатура И СтруктураТовар.Серия = Строка.Серия И СтруктураТовар.Характеристика = Строка.Характеристика Тогда
			СтрокаНайдена = Истина;	
			Дерево.Строки.Удалить(Строка);
			ДобавитьСтрокуВДерево(СтруктураТовар, Дерево);
			Возврат Дерево;
		КонецЕсли;  
		
	КонецЦикла;
	
	Если Не СтрокаНайдена Тогда
		Возврат ДобавитьСтрокуВДерево(СтруктураТовар, Дерево);	
	КонецЕсли;     
	
	Возврат Дерево;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьСтрокуВДерево(СтруктураЗаполнения, Дерево)        
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НоменклатураДрагоценныеМатериалы.Ссылка КАК НоменклатураРодитель,
	|	НоменклатураДрагоценныеМатериалы.ДрагоценныйМатериал КАК ДрагоценныйМатериал,
	|	НоменклатураДрагоценныеМатериалы.Количество КАК КоличествоДрагоценныйМатериал,
	|	НоменклатураДрагоценныеМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	НоменклатураДрагоценныеМатериалы.СБ_ПроцентСодержания КАК СБ_ПроцентСодержания,
	|	НоменклатураДрагоценныеМатериалы.Ссылка.СБ_ИспользоватьПроцентСодержания КАК СБ_ИспользоватьПроцентСодержания,
	|	НоменклатураДрагоценныеМатериалы.Ссылка.ВесЧислитель КАК Вес
	|ИЗ
	|	Справочник.Номенклатура.ДрагоценныеМатериалы КАК НоменклатураДрагоценныеМатериалы
	|ГДЕ
	|	НоменклатураДрагоценныеМатериалы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", СтруктураЗаполнения.Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	НоваяСтрокаРодитель = Дерево.Строки.Добавить();
	
	НоваяСтрокаРодитель.Номенклатура = СтруктураЗаполнения.Номенклатура;
	//НоваяСтрока.Номенклатура = Выборка.ДрагоценныйМатериал;
	НоваяСтрокаРодитель.Характеристика = СтруктураЗаполнения.Характеристика;
	НоваяСтрокаРодитель.Количество = СтруктураЗаполнения.КоличествоУпаковок; 
	//НоваяСтрока.Количество = Выборка.КоличествоУпаковок;
	НоваяСтрокаРодитель.ЕдиницаИзмерения = СтруктураЗаполнения.ЕдиницаИзмерения;
	НоваяСтрокаРодитель.Склад = СтруктураЗаполнения.Склад;
	НоваяСтрокаРодитель.Серия = СтруктураЗаполнения.Серия;
	//НоваяСтрокаРодитель.ЛигатурныйВес = Выборка.Вес;
	НоваяСтрокаРодитель.ЧистыйВес = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрокаРодитель.ЛигатурныйВес = Выборка.Вес;
		
		НоваяСтрока = НоваяСтрокаРодитель.Строки.Добавить();
		
		НоваяСтрока.Номенклатура = Выборка.ДрагоценныйМатериал;
		НоваяСтрока.Характеристика = НоваяСтрокаРодитель.Характеристика;
		//НоваяСтрока.Количество = НоваяСтрокаРодитель.Количество; 
		//НоваяСтрока.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
		//НоваяСтрока.Склад = НоваяСтрокаРодитель.Склад;
		//НоваяСтрока.Серия = НоваяСтрокаРодитель.Серия;
		//НоваяСтрока.ЛигатурныйВес = Выборка.Вес;
		
		Если Выборка.СБ_ИспользоватьПроцентСодержания Тогда
			НоваяСтрока.ЧистыйВес = НоваяСтрокаРодитель.Количество * Выборка.Вес * (Выборка.СБ_ПроцентСодержания / 100);	
		Иначе
			НоваяСтрока.ЧистыйВес = НоваяСтрокаРодитель.Количество * Выборка.КоличествоДрагоценныйМатериал;
		КонецЕсли;
		
		НоваяСтрокаРодитель.ЧистыйВес = НоваяСтрокаРодитель.ЧистыйВес + НоваяСтрока.ЧистыйВес;
		
		
		
		
		
	КонецЦикла;
	
	Возврат Дерево;
	
КонецФункции 

&НаСервере
Процедура ПересчитатьТаблицуДрагоценныеМеталлы()        
	
	ДеревоВТаблицу = РеквизитФормыВЗначение("ДеревоДрагМеталлы");           
	Объект.СБ_ДрагоценныеМеталлы.Очистить();
	СБ_РаботаСДеревомЗначений.ВыгрузитьДеревоЗначенийВТаблицуЗначений(ДеревоВТаблицу, Объект.СБ_ДрагоценныеМеталлы);
	
КонецПроцедуры

&НаСервере
Процедура СБ_ПересчитатьДрагМеталлыПослеНаСервере()      
	
	ОбъектТовары = РеквизитФормыВЗначение("Объект.Товары");
	СБ_РаботаСДрагоценнымиМеталлами.ЗаполнитьПустуюТаблицуДрагМеталлы(ОбъектТовары, Объект.СБ_ДрагоценныеМеталлы, Объект.Склад, Истина); 
	//Элементы.ДеревоДрагМеталлы.Очистить();
	//Дерево = РеквизитФормыВЗначение("ДеревоДрагМеталлы");                                            
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Родитель", "Родитель");
	ДеревоИзТаблицы = СБ_РаботаСДрагоценнымиМеталлами.ВыгрузитьТаблицуЗначенийВДеревоЗначений(Объект.СБ_ДрагоценныеМеталлы.Выгрузить(), "РодительНоменклатура", "РодительНоменклатура");
	
	ЗначениеВРеквизитФормы(ДеревоИзТаблицы, "ДеревоДрагМеталлы");                        
	
КонецПроцедуры

&НаКлиенте
Процедура СБ_ПересчитатьДрагМеталлыПосле(Команда)
	СБ_ПересчитатьДрагМеталлыПослеНаСервере();
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("ОткрытьПодборСерийЗавершение")
Процедура СБ_ОткрытьПодборСерийЗавершение(Результат, ДополнительныеПараметры)
	
	ПараметрыФормыУказанияСерий = ДополнительныеПараметры.ПараметрыФормыУказанияСерий;
    
    
    ЗначениеВозврата = Результат;
    
	Если ЗначениеВозврата <> Неопределено Тогда
		
		#Вставка     
		
		Структура = СБ_ПоискСерии(Результат);
		
		ПересчитатьКоличество(
		ТекущийЭлемент.ТекущиеДанные.Номенклатура, 
		ТекущийЭлемент.ТекущиеДанные.Характеристика, 
		Структура.Серия, 
		?(ЗначениеЗаполнено(Структура.КоличествоУпаковок), Структура.КоличествоУпаковок, ТекущийЭлемент.ТекущиеДанные.КоличествоУпаковок), 
		Объект.Склад, 
		ТекущийЭлемент.ТекущиеДанные.Упаковка); 
		
		ПересчитатьТаблицуДрагоценныеМеталлы(); 
		
		#КонецВставки
		
        ОбработатьУказаниеСерийСервер(ПараметрыФормыУказанияСерий);
	КонецЕсли;
	
	#Вставка     
	ПроверитьСтрокиВДеревеНаСуществованиеНаСервере();
	#КонецВставки

КонецПроцедуры  

&НаСервере
Функция СБ_ПоискСерии(АдресВоВременномХранилище)
	
	Результат = Новый Структура;
	Результат.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());
	Результат.Вставить("КоличествоУпаковок", 0);
	
	ТаблицаСерийИКоличества = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	
	Если ТаблицаСерийИКоличества.Количество() > 0 Тогда
		
		СтрокаИзВременногоХранилища = ТаблицаСерийИКоличества.Получить(0);
		
		Результат["Серия"] = СтрокаИзВременногоХранилища.Серия;
		Результат["КоличествоУпаковок"] = СтрокаИзВременногоХранилища.КоличествоУпаковок;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьСтрокиНаСуществование(ТаблицаТовары, ДеревоДрагМеталлы) 
	
	Для Каждого СтрокаДерева Из ДеревоДрагМеталлы.Строки Цикл
		СтрокаНайдена = Ложь;
		Для Каждого СтрокаТЧ Из ТаблицаТовары Цикл
			
			Если СтрокаТЧ.Номенклатура = СтрокаДерева.Номенклатура
				И СтрокаТЧ.Характеристика = СтрокаДерева.Характеристика
				И СтрокаТЧ.Серия = СтрокаДерева.Серия Тогда
				СтрокаНайдена = Истина;	
			КонецЕсли;
			
		КонецЦикла;	
		
		Если Не СтрокаНайдена Тогда
			ДеревоДрагМеталлы.Строки.Удалить(СтрокаДерева);		
		КонецЕсли;
		
	КонецЦикла;
	
	
	
КонецПроцедуры 

&НаСервере
Процедура ПроверитьСтрокиВДеревеНаСуществованиеНаСервере() 
	ДеревоВТаблицу = РеквизитФормыВЗначение("ДеревоДрагМеталлы"); 
	ПроверитьСтрокиНаСуществование(Объект.Товары, ДеревоВТаблицу);
	ЗначениеВРеквизитФормы(ДеревоВТаблицу, "ДеревоДрагМеталлы");
КонецПроцедуры

