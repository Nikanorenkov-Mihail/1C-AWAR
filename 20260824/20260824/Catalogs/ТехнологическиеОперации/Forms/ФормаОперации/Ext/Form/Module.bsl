
// Расширение SB_Adaptation_2. Пункт 3.6 ТЗ №1 — вспомогательные операции (интерфейс).
//
// Флажок «Вспомогательная операция» на форме элемента справочника «Технологические
// операции» создаётся программно, структура заимствованной формы не меняется.

&После("ПриСозданииНаСервере")
Процедура SB_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	SB_ДобавитьФлажокВспомогательнаяОперация();

КонецПроцедуры

&НаСервере
Процедура SB_ДобавитьФлажокВспомогательнаяОперация()

	Если Элементы.Найти("SB_ВспомогательнаяОперация") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Размещаем рядом с прочими реквизитами операции (наименование, вид, участок, РЦ).
	// Если группа не найдена, Неопределено как родитель добавит флажок в корень формы.
	ГруппаРазмещения = Элементы.Найти("ГруппаШапкиЛево");

	Флажок = Элементы.Добавить("SB_ВспомогательнаяОперация", Тип("ПолеФормы"), ГруппаРазмещения);
	Флажок.Вид         = ВидПоляФормы.ПолеФлажка;
	Флажок.ПутьКДанным = "Объект.SB_ВспомогательнаяОперация";
	Флажок.Заголовок   = НСтр("ru = 'Вспомогательная операция'");

КонецПроцедуры
