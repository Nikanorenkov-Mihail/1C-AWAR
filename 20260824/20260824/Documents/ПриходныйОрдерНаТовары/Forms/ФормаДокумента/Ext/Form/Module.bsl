&После("ПриОткрытии")
Процедура ПриОткрытии_Расширение(Отказ)
    ОбновитьВидимостьНоменклатурыПоставщика();
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
        ЗаполнитьНоменклатуруПоставщикаВСтроке(СтрокаТЧ);
	КонецЦикла;  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНоменклатуруПоставщикаВСтроке(СтрокаТЧ)
    Если СтрокаТЧ = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    СтрокаТЧ.НоменклатураПоставщика = Неопределено;
    
    Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) 
       Или Не ЗначениеЗаполнено(Объект.Отправитель) Тогда
        Возврат;
    КонецЕсли;
    
    СтрокаТЧ.НоменклатураПоставщика = НайтиНоменклатуруПоставщика(
        СтрокаТЧ.Номенклатура, 
        Объект.Отправитель);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьНоменклатурыПоставщика()
    Распоряжение = Объект.Распоряжение;
    Показывать = ОснованиеЭтоЗаказИлиПриобретение(Распоряжение);
    Элементы.ТоварыНоменклатураПоставщика.Видимость = Показывать;
КонецПроцедуры

