
&После("ПриЗаписи")
Процедура СБ_ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Ссылка.ВидНоменклатуры.ПринадлежитЭлементу(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Справочники.СБ_Предопределенные.ИзделияГруппа, "Значение").Родитель.Родитель) Тогда
		
		Если ЭтотОбъект.ВидНоменклатуры.ИспользоватьУпаковки Тогда
			ЭтотОбъект.ИспользоватьУпаковки = Истина;
			ЭтотОбъект.НаборУпаковок = ЭтотОбъект.ВидНоменклатуры.НаборУпаковок;
		КонецЕсли; 
		
		АвтоЗаполнениеШтрихкода(ЭтотОбъект);
		ПроверитьИСоздатьИндивидуальнуюУпаковку(ЭтотОбъект);
	КонецЕсли;  
	
КонецПроцедуры  

////////////////////////////////////////////////////////////////////////////////
// Основная логика: проверка наличия и создание штрихкода
Процедура АвтоЗаполнениеШтрихкода(ОбъектНоменклатуры) Экспорт
	
	Если ОбъектНоменклатуры.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	НоменклатураСсылка = ОбъектНоменклатуры.Ссылка;
	Если НоменклатураСсылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура
	|ИЗ
	|    РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|    ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураСсылка);
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	КодНоменклатуры = СокрЛП(ОбъектНоменклатуры.Код);
	ТолькоЦифры = "";
	Для Сч = 1 По СтрДлина(КодНоменклатуры) Цикл
		Символ = Сред(КодНоменклатуры, Сч, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			ТолькоЦифры = ТолькоЦифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Если ТолькоЦифры = "" Тогда
		ТолькоЦифры = "0";
	КонецЕсли;
	
	Пока СтрДлина(ТолькоЦифры) < 12 Цикл
		ТолькоЦифры = "0" + ТолькоЦифры;
	КонецЦикла;
	Если СтрДлина(ТолькоЦифры) > 12 Тогда
		ТолькоЦифры = Прав(ТолькоЦифры, 12);
	КонецЕсли;
	
	КонтрольнаяЦифра = РассчитатьКонтрольнуюЦифруEAN13(ТолькоЦифры);
	ИтоговыйШтрихкод = ТолькоЦифры + Строка(КонтрольнаяЦифра);
	
	ЗаписьРегистра = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Номенклатура = НоменклатураСсылка;
	ЗаписьРегистра.Штрихкод = ИтоговыйШтрихкод;
	
	Попытка
		ЗаписьРегистра.Записать();  
	Исключение 
		Сообщить("Ошибка записи: " + ОписаниеОшибки());
	КонецПопытки;
	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Проверка и создание индивидуальной упаковки
Процедура ПроверитьИСоздатьИндивидуальнуюУпаковку(ОбъектНоменклатуры) Экспорт
	
	Если ОбъектНоменклатуры.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбъектНоменклатуры.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
		
		БазоваяЕдиница = ОбъектНоменклатуры.ЕдиницаИзмерения;
		Если БазоваяЕдиница.Пустая() Тогда
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		|ГДЕ
		|	УпаковкиЕдиницыИзмерения.Владелец = &Владелец
		|	И УпаковкиЕдиницыИзмерения.ЕдиницаИзмерения = &БазоваяЕдиница
		|	И УпаковкиЕдиницыИзмерения.ТипУпаковки = &ТипУпаковки
		|	И УпаковкиЕдиницыИзмерения.Числитель = &Числитель
		|	И УпаковкиЕдиницыИзмерения.Знаменатель = &Знаменатель";
		Запрос.УстановитьПараметр("Владелец", ОбъектНоменклатуры.Ссылка);
		Запрос.УстановитьПараметр("БазоваяЕдиница", БазоваяЕдиница);
		Запрос.УстановитьПараметр("ТипУпаковки", Перечисления.ТипыУпаковокНоменклатуры.Конечная);
		Запрос.УстановитьПараметр("Числитель", 1);
		Запрос.УстановитьПараметр("Знаменатель", 1);
		Результат = Запрос.Выполнить();
		
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Возврат;
		КонецЕсли;
		
		НоваяУпаковка = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
		НоваяУпаковка.Владелец = ОбъектНоменклатуры.Ссылка;
		
		НоваяУпаковка.Числитель = 1;
		НоваяУпаковка.Знаменатель = 1; 
		
		НоваяУпаковка.ЕдиницаИзмерения 			=	БазоваяЕдиница;
		НоваяУпаковка.ТипИзмеряемойВеличины 	=	Перечисления.ТипыИзмеряемыхВеличин.Упаковка;
		НоваяУпаковка.ТипУпаковки = Перечисления.ТипыУпаковокНоменклатуры.Конечная; 
		
		НоваяУпаковка.СкладскаяГруппа = Справочники.СкладскиеГруппыУпаковок.НайтиПоНаименованию("Штуки");
		
		НоваяУпаковка.Наименование = Справочники.УпаковкиЕдиницыИзмерения.СформироватьНаименование(НоваяУпаковка.ТипУпаковки, НоваяУпаковка.ЕдиницаИзмерения, НоваяУпаковка.Числитель, НоваяУпаковка.Знаменатель, НоваяУпаковка.ЕдиницаИзмерения);
		
		БазовыеЕдиницыИзмерения = Справочники.УпаковкиЕдиницыИзмерения.БазовыеЕдиницыИзмерения();
		
		НоваяУпаковка.ВесЕдиницаИзмерения = БазовыеЕдиницыИзмерения.ВесЕдиницаИзмерения;
		НоваяУпаковка.ВысотаЕдиницаИзмерения = БазовыеЕдиницыИзмерения.ВысотаЕдиницаИзмерения;
		НоваяУпаковка.ГлубинаЕдиницаИзмерения = БазовыеЕдиницыИзмерения.ГлубинаЕдиницаИзмерения;
		НоваяУпаковка.ШиринаЕдиницаИзмерения = БазовыеЕдиницыИзмерения.ШиринаЕдиницаИзмерения;
		НоваяУпаковка.ОбъемЕдиницаИзмерения = БазовыеЕдиницыИзмерения.ОбъемЕдиницаИзмерения;
		НоваяУпаковка.ЛинейныеРазмерыПредставление = Строка(""+НоваяУпаковка.Высота + " X " + НоваяУпаковка.Ширина + " X "+НоваяУпаковка.Глубина); 
		
		Попытка
			НоваяУпаковка.Записать();
		Исключение
			Сообщить("Ошибка создания: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Расчёт контрольной цифры EAN-13
Функция РассчитатьКонтрольнуюЦифруEAN13(Код12)
	
	Сумма = 0;
	Для i = 1 По 12 Цикл
		Цифра = Число(Сред(Код12, i, 1));
		Если i % 2 = 1 Тогда
			Сумма = Сумма + Цифра * 1;
		Иначе
			Сумма = Сумма + Цифра * 3;
		КонецЕсли;
	КонецЦикла;
	
	Контрольная = 10 - (Сумма % 10);
	Если Контрольная = 10 Тогда
		Контрольная = 0;
	КонецЕсли;
	
	Возврат Контрольная;
	
КонецФункции

