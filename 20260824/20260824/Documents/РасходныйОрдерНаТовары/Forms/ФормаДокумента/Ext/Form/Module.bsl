&НаСервере
Функция СБ_ПоискСерии(АдресВоВременномХранилище)
	
	Результат = Новый Структура;
	Результат.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());
	Результат.Вставить("КоличествоУпаковок", 0);
	
	ТаблицаСерийИКоличества = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	
	Если ТаблицаСерийИКоличества.Количество() > 0 Тогда
		
		СтрокаИзВременногоХранилища = ТаблицаСерийИКоличества.Получить(0);
		
		Результат["Серия"] = СтрокаИзВременногоХранилища.Серия;
		Результат["КоличествоУпаковок"] = СтрокаИзВременногоХранилища.КоличествоУпаковок;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьСтрокиНаСуществование(ТаблицаТовары, ДеревоДрагМеталлы) 
	
	Для Каждого СтрокаДерева Из ДеревоДрагМеталлы.Строки Цикл
		СтрокаНайдена = Ложь;
		Для Каждого СтрокаТЧ Из ТаблицаТовары Цикл
			
			Если СтрокаТЧ.Номенклатура = СтрокаДерева.Номенклатура
				И СтрокаТЧ.Характеристика = СтрокаДерева.Характеристика
				И СтрокаТЧ.Серия = СтрокаДерева.Серия Тогда
				СтрокаНайдена = Истина;	
			КонецЕсли;
						
		КонецЦикла;	
		
		Если Не СтрокаНайдена Тогда
			ДеревоДрагМеталлы.Строки.Удалить(СтрокаДерева);		
		КонецЕсли;
		
	КонецЦикла;
	
	
	
КонецПроцедуры 

&НаСервере
Процедура ПроверитьСтрокиВДеревеНаСуществованиеНаСервере() 
	ДеревоВТаблицу = РеквизитФормыВЗначение("ДеревоДрагМеталлы"); 
	ПроверитьСтрокиНаСуществование(Объект.ОтгружаемыеТовары, ДеревоВТаблицу);
	ЗначениеВРеквизитФормы(ДеревоВТаблицу, "ДеревоДрагМеталлы");
КонецПроцедуры

