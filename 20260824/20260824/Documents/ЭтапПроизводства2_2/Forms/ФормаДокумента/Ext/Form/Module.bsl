
Функция СоздатьСерию(Номенклатура,Распоряжение) 
	
	ВладелецСерий     = ?(ЗначениеЗаполнено(Номенклатура.ВидНоменклатуры.ВладелецСерий),Номенклатура.ВидНоменклатуры.ВладелецСерий,Номенклатура.ВидНоменклатуры); 
	МаксимальныйНомерИзСправочника = Справочники.СерииНоменклатуры.ВычислитьМаксимальныйНомерСерии(ВладелецСерий);
	
	Номер = МаксимальныйНомерИзСправочника+1;
			 
	Серия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
	Серия.ВидНоменклатуры 	= Номенклатура.ВидНоменклатуры;	
	Серия.Номер             = Номер;
	Серия.ДатаПроизводства 	= ТекущаяДата();
	Серия.ГоденДо 			= ДобавитьМесяц(ТекущаяДата(),12*?(ЗначениеЗаполнено(Номенклатура.СрокГодности), Номенклатура.СрокГодности, 1));
	Серия.Наименование      = Номер+ " от "+Серия.ДатаПроизводства+" до "+Серия.ГоденДо;
	Серия.Записать();
				 
	Возврат Серия.Ссылка;
		
КонецФункции
	 
Функция ПроверитьВедениеУчетаПоСериям(Номенклатура) 
	
	ВидНоменклатуры     = ?(ЗначениеЗаполнено(Номенклатура.ВидНоменклатуры.ВладелецСерий),Номенклатура.ВидНоменклатуры.ВладелецСерий,Номенклатура.ВидНоменклатуры);  
	Возврат ВидНоменклатуры.ИспользоватьСерии;
	
КонецФункции
	 
Функция ВернутьСтатус() 
		 Возврат Перечисления.СтатусыЭтаповПроизводства2_2.Завершен;
КонецФункции

&НаКлиенте 
Процедура SB1_СтатусПриИзмененииПосле(Элемент)
	
	Попытка
		 Для каждого стр из Объект.ВыходныеИзделия Цикл   
			 Если стр.Произведено или Объект.Статус = ВернутьСтатус() Тогда
				 Если	ПроверитьВедениеУчетаПоСериям(стр.Номенклатура) Тогда  
					 НайдСтроки = Объект.ВыходныеИзделияСерии.НайтиСтроки(Новый Структура("Номенклатура", стр.Номенклатура)); 
					 Если НайдСтроки.Количество() = 0 Тогда 
						 Серия = СоздатьСерию(Стр.Номенклатура,Объект.Распоряжение); 
						 Если ЗначениеЗаполнено(Серия) Тогда
							 СтрСерия = Объект.ВыходныеИзделияСерии.Добавить();
							 ЗаполнитьЗначенияСвойств(СтрСерия,Стр); 
							 СтрСерия.Серия =  	Серия;
							 стр.СтатусУказанияСерий = 4;  
							 стр.СтатусУказанияСерийОтправитель = 2;
							 стр.СтатусУказанияСерийПолучатель = 4;
							 
						 КонецЕсли;
					 КонецЕсли;
				 КонецЕсли;  
			 КонецЕсли;
		 КонецЦикла; 
	 Исключение
	 КонецПопытки;
	 
КонецПроцедуры

&НаКлиенте
Процедура SB1_ВыходныеИзделияПроизведеноПриИзмененииПосле(Элемент)
	
	ТекущиеДанные = Элементы.ВыходныеИзделия.ТекущиеДанные;  
	Попытка
		Если Объект.Статус = ВернутьСтатус() или ТекущиеДанные.Произведено Тогда
			Если  ПроверитьВедениеУчетаПоСериям(ТекущиеДанные.Номенклатура) Тогда 
				 
				НайдСтроки = Объект.ВыходныеИзделияСерии.НайтиСтроки(Новый Структура("Номенклатура", ТекущиеДанные.Номенклатура)); 
				Если НайдСтроки.Количество() = 0 Тогда 
					СтрСерия = Объект.ВыходныеИзделияСерии.Добавить();
					ЗаполнитьЗначенияСвойств(СтрСерия,ТекущиеДанные);
					СтрСерия.Серия =  СоздатьСерию(ТекущиеДанные.Номенклатура,Объект.Распоряжение);
					ТекущиеДанные.СтатусУказанияСерий = 4;  
					ТекущиеДанные.СтатусУказанияСерийОтправитель = 2;
					ТекущиеДанные.СтатусУказанияСерийПолучатель = 4;
					 
				КонецЕсли;  
			КонецЕсли;
		КонецЕсли;  
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция ПроверкаУчетаСерийМатериалов(Строка) 
	
	ВидНоменклатуры    = ?(ЗначениеЗаполнено(Строка.Номенклатура.ВидНоменклатуры.ВладелецСерий),Строка.Номенклатура.ВидНоменклатуры.ВладелецСерий,Строка.Номенклатура.ВидНоменклатуры);  
	Если ВидНоменклатуры.ИспользоватьСерии И ВидНоменклатуры.ПолитикаУчетаСерий.УказыватьПриРасходеМатериалов Тогда 
		Отбор = Новый Структура("Склад",Строка.Склад);
		ПроверкаСклада = ВидНоменклатуры.ПолитикиУчетаСерий.НайтиСтроки(Отбор);
		Если ПроверкаСклада.Количество()>0 Тогда
			ПолитикаУчетаСерий = ПроверкаСклада[0].ПолитикаУчетаСерий;
		Иначе
			ПолитикаУчетаСерий = ВидНоменклатуры.ПолитикаУчетаСерий; 
		КонецЕсли;
		
		Если ПолитикаУчетаСерий = Справочники.ПолитикиУчетаСерий.СерииНеИспользуются Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;		
	Иначе	
		Возврат Ложь;	
	КонецЕсли;
	
КонецФункции 

&НаСервере
&ИзменениеИКонтроль("ПослеЗаполненияОбеспечения")
Процедура СБ_ПослеЗаполненияОбеспечения(Изменения, Режим = Неопределено, ПараметрыЗаполнения = Неопределено)
	
	ИзмененныеРеквизиты = Документы.ЭтапПроизводства2_2.ПослеЗаполненияОбеспечения(
		Объект,
		Изменения,
		Режим,
		ПараметрыЗаполнения,
		ДанныеЗаполненияПриИзмененииСтатуса());
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "НеОтгружатьЧастями");
		
	СтруктураДействий = Новый Структура();
	ОбеспечениеВДокументахКлиентСервер.ДобавитьДействияОбеспечения(
		СтруктураДействий,
		"СкладОбязателен,ДатаОтгрузкиОбязательна",
		ПараметрыДокументаДляДействийОбеспечения(ЭтотОбъект));
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	КоллекцияНаФорме = ОбеспечениеВДокументахКлиентСервер.КоллекцияНаФорме(
		ЭтотОбъект, ДоступныеОстаткиПараметрыВстраивания);
	
	ОбрабатываемыеСтроки = Новый Массив();
	
	Для Каждого Изменение Из Изменения Цикл
		ОбрабатываемыеСтроки.Добавить(Изменение.Строка);
	КонецЦикла;
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(
		ОбрабатываемыеСтроки,
		СтруктураДействий,
		КоллекцияНаФорме,
		КэшированныеЗначения);
	
	ОбеспечениеВДокументахКлиентСервер.ЗаполнитьСлужебныеРеквизиты(
		Объект.ОбеспечениеМатериаламиИРаботами,
		ДатаОтгрузкиОбязательна,
		СкладОбязателен);
	#Вставка
	ЗаполнитьСерииОбеспечениеМатериаламиИРаботами();
	#КонецВставки

	Если ТекущийСтатус <> Объект.Статус Тогда
		ПослеИзмененияСтатусаНаСервере(ИзмененныеРеквизиты);
	КонецЕсли;
	ОбновитьКолонкуДоступноСервер();
	
КонецПроцедуры

Процедура ЗаполнитьСерииОбеспечениеМатериаламиИРаботами()   
	
	Попытка
		Сч = 0;
		Для каждого стрр из Объект.ОбеспечениеМатериаламиИРаботами цикл 
			Если ПроверкаУчетаСерийМатериалов(стрр) и стрр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить и НЕ ЗначениеЗаполнено(стрр.Серия) Тогда 
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК ВНаличииОстаток,
					|	ТоварыНаСкладахОстатки.Серия КАК Серия
					|ПОМЕСТИТЬ ВТ
					|ИЗ
					|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
					|ГДЕ
					|	ТоварыНаСкладахОстатки.Номенклатура = &Номенклатура
					|	И ТоварыНаСкладахОстатки.Характеристика = &Характеристика
					|	И ТоварыНаСкладахОстатки.Назначение = &Назначение
					|	И ТоварыНаСкладахОстатки.Склад = &Склад
					|	И ТоварыНаСкладахОстатки.ВНаличииОстаток > 0
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	МИНИМУМ(ТоварыНаСкладах.Период) КАК Период,
					|	СУММА(ЕСТЬNULL(ВТ.ВНаличииОстаток, 0)) КАК ВНаличииОстаток,
					|	ВТ.Серия КАК Серия,
					|	СУММА(ЕСТЬNULL(ТоварыНаСкладах.ВНаличии, 0)) КАК ВНаличииПришло
					|ИЗ
					|	ВТ КАК ВТ
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
					|		ПО ВТ.Серия = ТоварыНаСкладах.Серия
					|ГДЕ
					|	ТоварыНаСкладах.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
					|	И ТоварыНаСкладах.Номенклатура = &Номенклатура
					|	И ТоварыНаСкладах.Характеристика = &Характеристика
					|	И ТоварыНаСкладах.Назначение = &Назначение
					|	И ТоварыНаСкладах.Склад = &Склад
					|	И ТоварыНаСкладах.ВНаличии > 0
					|
					|СГРУППИРОВАТЬ ПО
					|	ВТ.Серия
					|
					|УПОРЯДОЧИТЬ ПО
					|	Период";
					 
					Запрос.УстановитьПараметр("Назначение", ?(стрр.Обособленно,стрр.Назначение,Справочники.Назначения.ПустаяСсылка()));
					Запрос.УстановитьПараметр("Номенклатура", стрр.Номенклатура);
					Запрос.УстановитьПараметр("Склад", стрр.Склад);
					Запрос.УстановитьПараметр("Характеристика", стрр.Характеристика);
					 
					РезультатЗапроса = Запрос.Выполнить().Выбрать();
					КоличествоОбщее = стрр.Количество; 
					КоличествоСтарт = стрр.Количество; 
					 
					Пока РезультатЗапроса.Следующий() и  КоличествоОбщее <>0 Цикл  
						Если КоличествоОбщее<>КоличествоСтарт Тогда  
							КолМинОстПришло = Мин(РезультатЗапроса.ВНаличииОстаток,РезультатЗапроса.ВНаличииПришло);
							МинКол =  Мин(КолМинОстПришло, КоличествоОбщее);  
							СтрОб = Объект.ОбеспечениеМатериаламиИРаботами.Вставить(Сч);
							//Добавить();
							ЗаполнитьЗначенияСвойств(СтрОб,стрр,,"ИдентификаторСтроки,КлючНоменклатура");
							СтрОб.Серия = РезультатЗапроса. Серия ;
							СтрОб.КоличествоУпаковок=МинКол;  
							СтрОб.Количество=МинКол;
							 
							КоличествоОбщее = КоличествоОбщее - МинКол; 
						Иначе 
							КолМинОстПришло = Мин(РезультатЗапроса.ВНаличииОстаток,РезультатЗапроса.ВНаличииПришло);
							МинКол =  Мин(КолМинОстПришло, КоличествоОбщее);
							стрр.Серия = РезультатЗапроса. Серия ;
							стрр.КоличествоУпаковок=МинКол; 
							стрр.Количество=МинКол;
							 
							КоличествоОбщее = КоличествоОбщее - МинКол; 
						КонецЕсли;
				КонецЦикла;
			КонецЕсли;   
			
			Сч = Сч+1;
		КонецЦикла;	
		
	Исключение
		
	КонецПопытки;  
	
КонецПроцедуры
		 
 
