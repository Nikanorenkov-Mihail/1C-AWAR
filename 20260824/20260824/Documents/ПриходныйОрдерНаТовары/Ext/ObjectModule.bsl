Функция ПринятоПолностью(СсылкаРаспоряжение)
	
	// Запрос суммарного принятого количества из проведённых приходных ордеров
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|    ПриходныеТовары.Номенклатура КАК Номенклатура,
	|    СУММА(ПриходныеТовары.Количество) КАК КоличествоПринято
	|ИЗ
	|    Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныеТовары
	|ГДЕ
	|    ПриходныеТовары.Ссылка.Распоряжение = &Основание
	|    И ПриходныеТовары.Ссылка.Проведен
	|СГРУППИРОВАТЬ ПО
	|    ПриходныеТовары.Номенклатура";
	
	Запрос.УстановитьПараметр("Основание", СсылкаРаспоряжение);
	Результат = Запрос.Выполнить();
	
	Принято = Новый Соответствие;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Принято.Вставить(Выборка.Номенклатура, Выборка.КоличествоПринято);
	КонецЦикла;
	
	// Проверяем по каждой строке распоряжения
	Для Каждого СтрокаРаспоряжения Из СсылкаРаспоряжение.Товары Цикл
		Номенклатура = СтрокаРаспоряжения.Номенклатура;
		КоличествоВРаспоряжении = СтрокаРаспоряжения.Количество;
		
		КоличествоПринято = 0;
		Если Принято.Получить(Номенклатура) <> Неопределено Тогда
			КоличествоПринято = Принято[Номенклатура];
		КонецЕсли;
		
		// Допуск 0.000001 для вещественных чисел
		Если КоличествоПринято < КоличествоВРаспоряжении - 0.000001 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура ПроведениеДрагМеталлов()	
	СБ_РаботаСДрагоценнымиМеталлами.ПроведениеДрагоценныеМеталлы(ЭтотОбъект, ВидДвиженияНакопления.Приход);
КонецПроцедуры

