
// Расширение SB_Adaptation_2. Пункт 3.6 ТЗ №1 — интерфейс спецификации.
//
// Программно, без изменения структуры заимствованной формы:
//  - колонка «Виртуальный узел» в таблице «Материалы и работы»;
//  - флажок «Вспомогательная операция» в панели операции «Производственного процесса».

&После("ПриСозданииНаСервере")
Процедура SB_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	SB_ДобавитьКолонкуВиртуальныйУзел();
	SB_ДобавитьФлажокВспомогательнаяОперация();

КонецПроцедуры

&НаСервере
Процедура SB_ДобавитьФлажокВспомогательнаяОперация()

	Если Элементы.Найти("SB_ВспомогательнаяОперацияПоле") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Панель операции привязана к реквизиту формы ПроизводственныйПроцессОперация
	// (тип CatalogObject.ТехнологическиеОперации), в котором наш реквизит уже есть.
	// Штатные флажки этой панели (МожноПовторить/МожноПропустить/Контроль) не имеют
	// отдельных обработчиков — правка сохраняется через ЗаписатьПроизводственныйПроцесс
	// при записи спецификации. Наш флажок устроен так же.
	ГруппаРазмещения = Элементы.Найти("ОперацияГруппаВыполнение");
	Если ГруппаРазмещения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Флажок = Элементы.Добавить("SB_ВспомогательнаяОперацияПоле", Тип("ПолеФормы"), ГруппаРазмещения);
	Флажок.Вид         = ВидПоляФормы.ПолеФлажка;
	Флажок.ПутьКДанным = "ПроизводственныйПроцессОперация.SB_ВспомогательнаяОперация";
	Флажок.Заголовок   = НСтр("ru = 'Вспомогательная операция'");

	// Галка слева от заголовка — как у «Можно повторить/пропустить».
	Флажок.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;

	// Доступность флажка по статусу спецификации настраивается в общем модуле
	// РедакторПроизводственногоПроцесса (&ИзменениеИКонтроль): наше поле добавлено там
	// в штатный список полей панели операции.

КонецПроцедуры

&НаСервере
Процедура SB_ДобавитьКолонкуВиртуальныйУзел()

	Если Элементы.Найти("SB_ВиртуальныйУзелКолонка") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТаблицаМатериалы = Элементы.Найти("МатериалыИУслуги");
	Если ТаблицаМатериалы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Колонка = Элементы.Добавить("SB_ВиртуальныйУзелКолонка", Тип("ПолеФормы"), ТаблицаМатериалы);
	Колонка.Вид         = ВидПоляФормы.ПолеФлажка;
	Колонка.ПутьКДанным = "Объект.МатериалыИУслуги.SB_ВиртуальныйУзел";
	Колонка.Заголовок   = НСтр("ru = 'Виртуальный узел'");

КонецПроцедуры
